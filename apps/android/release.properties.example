# Public inputs become Gradle properties; secret signing inputs are environment
# variables and protected files, never Gradle command-line values.
kurastorage.apiHostname=api.kurastorage.example
kurastorage.lanApiAddress=192.0.2.10
kurastorage.zerotierApiAddress=198.51.100.10
kurastorage.rootCaCertificate=SET_LOCALLY
kurastorage.versionName=0.1.0
kurastorage.versionCode=1

# Environment variable names used by release builds:
# KURASTORAGE_RELEASE_KEYSTORE
# KURASTORAGE_RELEASE_KEY_ALIAS
# KURASTORAGE_RELEASE_STORE_PASSWORD_FILE
# KURASTORAGE_RELEASE_KEY_PASSWORD_FILE
