limit_req_zone $binary_remote_addr zone=kurastorage_auth:10m rate=5r/m;

# Deliberately log $uri rather than $request, $request_uri, or $args so search
# text, identifiers, tokens, and other query values never enter access logs.
log_format kurastorage_safe '$remote_addr [$time_local] "$request_method $uri $server_protocol" '
                            '$status $body_bytes_sent $request_time';

upstream kurastorage_api {
    server unix:/run/kurastorage/api.sock;
}

server {
    listen ${KURASTORAGE_LAN_API_IP}:443 ssl;
    server_name ${KURASTORAGE_API_HOSTNAME};
    access_log /var/log/nginx/kurastorage-access.log kurastorage_safe;

    ssl_certificate /etc/kurastorage/tls/server.crt;
    ssl_certificate_key /etc/kurastorage/tls/server.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_tickets off;

    allow ${KURASTORAGE_LAN_CIDR};
    deny all;

    location / {
        proxy_set_header X-KuraStorage-Route LOCAL_DIRECT;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For "";
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_read_timeout 3600s;
        client_max_body_size 0;
        proxy_pass http://kurastorage_api;
    }

    location ~ ^/api/v1/upload-sessions/[0-9a-fA-F-]+/chunks$ {
        proxy_set_header X-KuraStorage-Route LOCAL_DIRECT;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For "";
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
        client_max_body_size 8m;
        proxy_pass http://kurastorage_api;
    }

    location ~ ^/api/v1/auth/(register-device|login)$ {
        limit_req zone=kurastorage_auth burst=5 nodelay;
        proxy_set_header X-KuraStorage-Route LOCAL_DIRECT;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For "";
        proxy_request_buffering off;
        proxy_pass http://kurastorage_api;
    }
}

server {
    listen ${KURASTORAGE_ZEROTIER_API_IP}:443 ssl;
    server_name ${KURASTORAGE_API_HOSTNAME};
    access_log /var/log/nginx/kurastorage-access.log kurastorage_safe;

    ssl_certificate /etc/kurastorage/tls/server.crt;
    ssl_certificate_key /etc/kurastorage/tls/server.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_tickets off;

    allow ${KURASTORAGE_ZEROTIER_CIDR};
    deny all;

    location ~ ^/api/v1/auth/(register-device|login)$ {
        limit_req zone=kurastorage_auth burst=5 nodelay;
        proxy_set_header X-KuraStorage-Route REMOTE_SECURE;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For "";
        proxy_request_buffering off;
        proxy_pass http://kurastorage_api;
    }

    location ~ ^/api/v1/upload-sessions/[0-9a-fA-F-]+/chunks$ {
        proxy_set_header X-KuraStorage-Route REMOTE_SECURE;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For "";
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
        client_max_body_size 8m;
        proxy_pass http://kurastorage_api;
    }

    location / {
        proxy_set_header X-KuraStorage-Route REMOTE_SECURE;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For "";
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_read_timeout 3600s;
        client_max_body_size 0;
        proxy_pass http://kurastorage_api;
    }
}
