{
  "AllowedHosts": "${KURASTORAGE_API_HOSTNAME}",
  "Database": {
    "ConnectionString": "Host=/var/run/postgresql;Database=${KURASTORAGE_POSTGRES_DATABASE};Username=${KURASTORAGE_POSTGRES_ROLE};Maximum Pool Size=20"
  },
  "Storage": {
    "RootPath": "${KURASTORAGE_STORAGE_ROOT}",
    "StorageId": "${KURASTORAGE_STORAGE_ID}",
    "MinimumFreeBytes": ${KURASTORAGE_STORAGE_RESERVE_BYTES},
    "CapacityWarningFreeBytes": ${KURASTORAGE_STORAGE_WARNING_BYTES}
  },
  "Media": {
    "DerivativeRoot": "${KURASTORAGE_MEDIA_DERIVATIVE_ROOT}",
    "TemporaryRoot": "${KURASTORAGE_MEDIA_TEMPORARY_ROOT}",
    "ImageWaitMilliseconds": ${KURASTORAGE_MEDIA_IMAGE_WAIT_MILLISECONDS},
    "ThumbnailProfileVersion": ${KURASTORAGE_MEDIA_THUMBNAIL_PROFILE_VERSION},
    "ImageProfileVersion": ${KURASTORAGE_MEDIA_IMAGE_PROFILE_VERSION},
    "VideoProfileVersion": ${KURASTORAGE_MEDIA_VIDEO_PROFILE_VERSION},
    "ThumbnailMaxDimension": ${KURASTORAGE_MEDIA_THUMBNAIL_MAX_DIMENSION},
    "ThumbnailWebpQuality": ${KURASTORAGE_MEDIA_THUMBNAIL_WEBP_QUALITY},
    "JobPollMilliseconds": ${KURASTORAGE_MEDIA_JOB_POLL_MILLISECONDS},
    "JobHeartbeatSeconds": ${KURASTORAGE_MEDIA_JOB_HEARTBEAT_SECONDS},
    "StaleJobSeconds": ${KURASTORAGE_MEDIA_STALE_JOB_SECONDS},
    "MaximumAttempts": ${KURASTORAGE_MEDIA_MAXIMUM_ATTEMPTS},
    "GenerationLeaseSeconds": ${KURASTORAGE_MEDIA_GENERATION_LEASE_SECONDS},
    "DeliveryLeaseSeconds": ${KURASTORAGE_MEDIA_DELIVERY_LEASE_SECONDS},
    "DeliveryLeaseRenewalSeconds": ${KURASTORAGE_MEDIA_DELIVERY_LEASE_RENEWAL_SECONDS},
    "CacheTtlHours": ${KURASTORAGE_MEDIA_CACHE_TTL_HOURS},
    "CacheHighWatermarkBytes": ${KURASTORAGE_MEDIA_CACHE_HIGH_WATERMARK_BYTES},
    "CacheLowWatermarkBytes": ${KURASTORAGE_MEDIA_CACHE_LOW_WATERMARK_BYTES},
    "CleanupIntervalMinutes": ${KURASTORAGE_MEDIA_CLEANUP_INTERVAL_MINUTES},
    "CleanupBatchSize": ${KURASTORAGE_MEDIA_CLEANUP_BATCH_SIZE},
    "TerminalJobRetentionDays": ${KURASTORAGE_MEDIA_TERMINAL_JOB_RETENTION_DAYS},
    "MaximumConcurrentMediaJobs": ${KURASTORAGE_MEDIA_MAXIMUM_CONCURRENT_MEDIA_JOBS},
    "MaximumConcurrentVideoJobs": ${KURASTORAGE_MEDIA_MAXIMUM_CONCURRENT_VIDEO_JOBS},
    "VipsPath": "${KURASTORAGE_MEDIA_VIPS_PATH}",
    "FfmpegPath": "${KURASTORAGE_MEDIA_FFMPEG_PATH}",
    "FfprobePath": "${KURASTORAGE_MEDIA_FFPROBE_PATH}",
    "PdftoppmPath": "${KURASTORAGE_MEDIA_PDFTOPPM_PATH}"
  },
  "TrashPurge": {
    "RetentionDays": ${KURASTORAGE_TRASH_RETENTION_DAYS},
    "IntervalHours": ${KURASTORAGE_TRASH_INTERVAL_HOURS},
    "BatchSize": ${KURASTORAGE_TRASH_BATCH_SIZE},
    "RetryDelayMinutes": ${KURASTORAGE_TRASH_RETRY_DELAY_MINUTES}
  },
  "UploadSession": {
    "PreferredChunkBytes": 4194304,
    "MaximumChunkBytes": 8388608,
    "MaximumFileBytes": 1099511627776,
    "IdleExpirationHours": 24,
    "AbsoluteExpirationHours": 168,
    "CleanupIntervalMinutes": 15,
    "CleanupBatchSize": 100,
    "MaximumActiveSessionsPerUser": 10,
    "MaximumActiveSessionsPerDevice": 5,
    "MaximumConcurrentChunkWrites": 2,
    "OverloadRetryAfterSeconds": 5
  },
  "Indexing": {
    "Enabled": false,
    "BatchSize": 500,
    "MissingConfirmationDelayMinutes": 5,
    "StagingRetentionHours": 24,
    "FullRescanIntervalMinutes": 360,
    "RunOnStartup": true,
    "EventDebounceMilliseconds": 500,
    "MovePairingWindowMilliseconds": 1000,
    "EventQueueCapacity": 4096,
    "RetryBackoffSeconds": 30
  },
  "Authentication": {
    "JwtIssuer": "kurastorage",
    "JwtAudience": "kurastorage-android",
    "JwtSigningKeyFile": "/etc/kurastorage/secrets/jwt-signing-key.pem",
    "AccessTokenMinutes": 15,
    "RefreshTokenHours": 24,
    "Argon2MemoryKiB": 19456,
    "Argon2Iterations": 2,
    "Argon2Parallelism": 1
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore.DataProtection": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "Microsoft.AspNetCore.Http.Result.FileStreamResult": "Warning",
      "Microsoft.AspNetCore.Hosting.Diagnostics": "Warning",
      "Microsoft.Hosting.Lifetime": "Warning"
    }
  }
}
