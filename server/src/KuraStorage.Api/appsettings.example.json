{
  "AllowedHosts": "api.kurastorage.example",
  "Database": {
    "ConnectionString": "Host=SET_LOCALLY;Port=5432;Database=kurastorage;Username=SET_LOCALLY;Password=SET_VIA_SECRET_FILE"
  },
  "Storage": {
    "RootPath": "SET_LOCALLY",
    "StorageId": "SET_LOCALLY",
    "MinimumFreeBytes": 1073741824,
    "CapacityWarningFreeBytes": 10737418240
  },
  "TrashPurge": {
    "RetentionDays": 30,
    "IntervalHours": 24,
    "BatchSize": 100,
    "RetryDelayMinutes": 15
  },
  "Authentication": {
    "JwtIssuer": "kurastorage",
    "JwtAudience": "kurastorage-android",
    "JwtSigningKeyFile": "SET_LOCALLY",
    "AccessTokenMinutes": 15,
    "RefreshTokenHours": 24,
    "Argon2MemoryKiB": 19456,
    "Argon2Iterations": 2,
    "Argon2Parallelism": 1
  },
  "Logging": {
    "LogLevel": {
      "Microsoft.AspNetCore.Http.Result.FileStreamResult": "Warning"
    }
  }
